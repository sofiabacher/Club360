{
  "name": "club360-api",
  "version": "1.0.0",
  "description": "API de Club360, plataforma de gestión para clubes deportivos",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed/seed.js",
    "seed:demo": "node src/seed/demo.js",
    "db:snapshot": "node src/scripts/db/snapshot.js",
    "db:restore": "node src/scripts/db/restore.js",
    "admin:unlock": "node src/scripts/adminUnlock.js",
    "bot:eval": "node scripts/botEval.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.4",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.14.0",
    "natural": "^8.2.6",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.3.1",
    "sequelize": "^6.37.7"
  },
  "overrides": {
    "sequelize": {
      "uuid": "^11.1.1"
    }
  }
}
