
NODE_ENV=development    # Entorno: development o production
PORT=3000               # Puerto de la API

DB_FORCE_SYNC=false      # Sincronización de tablas (borra y recrea al arrancar server)
DB_ALTER_SYNC=false      # Ajuste de tablas a los modelos sin borrar datos

# MySQL local (desarrollo)
DB_NAME=club360
DB_USER=root
DB_PASS=
DB_HOST=localhost
DB_PORT=3306

# Base en la nube (demo). Si está definida, se usa en lugar de las variables DB_* y con SSL
# DATABASE_URL=mysql://usuario:clave@host:3306/club360

BCRYPT_SALT_ROUNDS=10      # Contraseñas (bcrypt)

# JWT (JSON Web Token)
JWT_SECRET= 
JWT_ACTIVATION_SECRET=
JWT_EXPIRES_IN=24h          # Duración del token de sesión
JWT_EMAIL_EXPIRES_IN=1h     # Duración de los tokens que se envían por email
JWT_ACTIVATION_EXPIRES_IN=48h   # Duración del link de activación de la cuenta del staff

ENCRYPTION_KEY=             # Clave para encriptación reversible (AES-256)

# --- Seed (usuario Admin del club) ---
SEED_ADMIN_NAME=Admin
SEED_ADMIN_LASTNAME=Valencia
SEED_ADMIN_EMAIL=admin@valencia-club.com
SEED_ADMIN_USERNAME=admin.valencia
SEED_ADMIN_PASSWORD=        # Contraseña del 1° admin (cada uno elige la suya)
SEED_ADMIN_BIRTHDATE=1990-01-01

# Email (nodemailer con Gmail SMTP). En desarrollo, sin SMTP_USER o SMTP_PASS no se envía nada: se muestra por consola
# SMTP_PASS es una contraseña de aplicación de Gmail (Cuenta de Google → Seguridad → Verificación en 2 pasos →
# Contraseñas de aplicación), no la contraseña de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465               # 465 (SSL) o 587 (STARTTLS)
SMTP_USER=                  # Cuenta de Gmail del equipo, por ejemplo: club360.equipo@gmail.com
SMTP_PASS=                  # Contraseña de aplicación (16 letras, sin espacios)
MAIL_FROM=                  # Remitente, por ejemplo: Club360 <club360.equipo@gmail.com>

# URL del frontend (CORS)
FRONTEND_URL=http://localhost:5173
