
NODE_ENV=development    # Entorno: development o production
PORT=3000               # Puerto de la API

DB_FORCE_SYNC=false      # Sincronización de tablas (borra y recrea al arrancar server)
DB_ALTER_SYNC=false      # Ajuste de tablas a los modelos sin borrar datos

# MySQL local (desarrollo)
DB_NAME=club360
DB_USER=root
DB_PASS=
DB_HOST=localhost
DB_PORT=3306

# Base en la nube (demo). Si está definida, se usa en lugar de las variables DB_* y con SSL
# DATABASE_URL=mysql://usuario:clave@host:3306/club360

BCRYPT_SALT_ROUNDS=10      # Contraseñas (bcrypt)

# JWT (JSON Web Token)
JWT_SECRET= 
JWT_ACTIVATION_SECRET=
JWT_EXPIRES_IN=24h          # Duración del token de sesión
JWT_EMAIL_EXPIRES_IN=1h     # Duración de los tokens que se envían por email

ENCRYPTION_KEY=             # Clave para encriptación reversible (AES-256)

# Email 
RESEND_API_KEY=             # Email (Resend). Sin RESEND_API_KEY los mails no se envían: se muestran por consola
EMAIL_FROM=                 # Remitente, por ejemplo: Club360 <avisos@tudominio.com>

# URL del frontend (CORS)
FRONTEND_URL=http://localhost:5173
