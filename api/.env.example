# Copiar este archivo como .env y completar. En la demo (Render), las mismas variables se cargan en Environment
# (docs/deploy.md, paso 4). Nunca se sube el .env al repo.

# --- Servidor ---
NODE_ENV=development    # development o production
PORT=3000               # Puerto de la API (en Render no se carga: la define Render)
FRONTEND_URL=http://localhost:5173   # URL del front, sin / al final: CORS y links de los emails

# Sincronización de tablas al arrancar. Siempre en false contra la base de la demo (en producción están bloqueadas)
DB_FORCE_SYNC=false     # Borra y recrea todas las tablas
DB_ALTER_SYNC=false     # Ajusta las tablas a los modelos sin borrar datos

# --- Base local (desarrollo) ---
DB_NAME=club360
DB_USER=root
DB_PASS=
DB_HOST=localhost
DB_PORT=3306

# --- Base en la nube (demo en Railway) ---
# Si está definida, se usa en lugar de las variables DB_*. Es la MYSQL_PUBLIC_URL del servicio de Railway
# DATABASE_URL=mysql://root:clave@host.proxy.rlwy.net:12345/railway
# DB_SSL=true           # Con DATABASE_URL se conecta por SSL; false solo si la base no lo acepta

# --- JWT (JSON Web Token) ---
# Para generar cada clave: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_ACTIVATION_SECRET=      # Distinta de JWT_SECRET: links de activación de la cuenta del staff
JWT_EXPIRES_IN=24h          # Duración del token de sesión
JWT_EMAIL_EXPIRES_IN=1h     # Duración de los tokens que se envían por email
JWT_ACTIVATION_EXPIRES_IN=48h   # Duración del link de activación de la cuenta del staff

# --- Cifrado ---
BCRYPT_SALT_ROUNDS=10       # Contraseñas (bcrypt)
# ENCRYPTION_KEY: clave para cifrar el teléfono (AES-256-GCM). Cualquier texto largo (se pasa por SHA-256): generala
# con el mismo comando que las de JWT. En la demo no se cambia una vez cargados los datos (no se podrían leer los teléfonos)
ENCRYPTION_KEY=

# --- Emails ---
# MAIL_PROVIDER: brevo (producción), smtp (Gmail, solo en local) o console (no envía: muestra destinatario, asunto y
# links por consola). Vacío: brevo si hay BREVO_API_KEY; si no, smtp si hay SMTP_USER y SMTP_PASS; si no, console.
# Render gratis bloquea SMTP: en la demo, brevo. El plan gratuito de Brevo permite 300 emails por día.
MAIL_PROVIDER=
BREVO_API_KEY=              # Brevo → SMTP & API → API Keys
MAIL_FROM=                  # Casilla remitente, verificada en Brevo (ej. club360.demo@gmail.com)
MAIL_FROM_NAME=Club360      # Nombre visible del remitente

# Gmail SMTP (opcional, solo para el desarrollo local). SMTP_PASS es una contraseña de aplicación de Gmail (Cuenta de
# Google → Seguridad → Verificación en 2 pasos → Contraseñas de aplicación), no la contraseña de la cuenta
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465               # 465 (SSL) o 587 (STARTTLS)
SMTP_USER=
SMTP_PASS=

# --- Cloudinary (imágenes y comprobantes, solo en producción) ---
# En desarrollo los archivos van a uploads/. En producción, sin estas tres, las subidas responden 503
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Seed (usuario Admin del club) ---
SEED_ADMIN_NAME=Admin
SEED_ADMIN_LASTNAME=Valencia
SEED_ADMIN_EMAIL=admin@valencia-club.com
SEED_ADMIN_USERNAME=admin.valencia
SEED_ADMIN_PASSWORD=        # Contraseña del primer Admin (cada uno elige la suya)
SEED_ADMIN_BIRTHDATE=1990-01-01
